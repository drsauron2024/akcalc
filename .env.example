# ChatECNU / ECNU LLM platform (OpenAI-compatible)
CHATECNU_API_KEY=sk-your-token-here
CHATECNU_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1

# Models
CHATECNU_CHAT_MODEL=ecnu-max
CHATECNU_FAST_MODEL=ecnu-plus
CHATECNU_EMBED_MODEL=ecnu-embedding-small
CHATECNU_RERANK_MODEL=ecnu-rerank

# Optional runtime knobs
AKCALC_LLM_TEMPERATURE=0
AKCALC_REQUEST_TIMEOUT=120
AKCALC_LOG_DIR=results/logs
